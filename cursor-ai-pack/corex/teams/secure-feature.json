{
  "id": "secure-feature",
  "name": "Безопасная фича",
  "description": "Разработка → аудит безопасности → QA",
  "limits": {
    "max_total_turns": 22,
    "max_turns_per_step": 7,
    "max_file_writes": 10,
    "delay_between_turns_ms": 600,
    "delay_between_steps_ms": 2500
  },
  "steps": [
    {
      "agent_id": "lead-developer",
      "role": "Старший разработчик",
      "goal": "Реализуй фичу с учётом безопасности.",
      "max_turns": 7,
      "allow_writes": true
    },
    {
      "agent_id": "security-auditor",
      "role": "Аудитор безопасности",
      "goal": "Проверь уязвимости и секреты. Исправь критичное.",
      "max_turns": 6,
      "allow_writes": true
    },
    {
      "agent_id": "qa-engineer",
      "role": "QA-инженер",
      "goal": "Добавь тесты на безопасные сценарии.",
      "max_turns": 5,
      "allow_writes": true
    }
  ]
}
