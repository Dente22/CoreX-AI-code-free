{
  "id": "quick-fix",
  "name": "Быстрое исправление",
  "description": "Один разработчик + ревьюер (лёгкий режим для слабого ПК)",
  "limits": {
    "max_total_turns": 14,
    "max_turns_per_step": 6,
    "max_file_writes": 6,
    "delay_between_turns_ms": 700,
    "delay_between_steps_ms": 3000
  },
  "steps": [
    {
      "persona_id": "developer",
      "role": "Разработчик",
      "goal": "Исправь проблему минимальным diff.",
      "max_turns": 6,
      "allow_writes": true
    },
    {
      "persona_id": "reviewer",
      "role": "Ревьюер",
      "goal": "Проверь исправление. Краткий отчёт пользователю.",
      "max_turns": 4,
      "allow_writes": false
    }
  ]
}
