{
  "id": "dev-team",
  "name": "Команда разработки",
  "description": "Разработчик → QA → ревью кода",
  "limits": {
    "max_total_turns": 22,
    "max_turns_per_step": 7,
    "max_file_writes": 10,
    "delay_between_turns_ms": 600,
    "delay_between_steps_ms": 2500
  },
  "steps": [
    {
      "agent_id": "lead-developer",
      "role": "Старший разработчик",
      "goal": "Реализуй задачу: напиши или измени код. Один файл за ход.",
      "max_turns": 7,
      "allow_writes": true
    },
    {
      "agent_id": "qa-engineer",
      "role": "QA-инженер",
      "goal": "Запусти main.py (run_file). Добавь тесты. Баги — write_file и повторный run_file до успеха.",
      "max_turns": 6,
      "allow_writes": true
    },
    {
      "agent_id": "code-reviewer",
      "role": "Ревьюер кода",
      "goal": "run_file main.py, code review. Баги — write_file + run_file снова. done только после успешного запуска.",
      "max_turns": 5,
      "allow_writes": true
    }
  ]
}
